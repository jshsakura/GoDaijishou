<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets this app (same signing key only) ask the system_server hook for privileged actions -->
    <permission
        android:name="kr.opencourse.godaijishou.permission.SYSTEM_ACTION"
        android:protectionLevel="signature" />
    <uses-permission android:name="kr.opencourse.godaijishou.permission.SYSTEM_ACTION" />

    <!-- Package visibility for checking other apps -->
    <queries>
        <package android:name="com.magneticchen.daijishou" />
        <package android:name="org.es_de.frontend" />
        <package android:name="org.pegasus_frontend.android" />
        <!-- For the Open LSPosed button -->
        <package android:name="org.lsposed.manager" />
        <!-- Host of the parasitic LSPosed manager -->
        <package android:name="com.android.shell" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/App.Theme.Godaijishou">

        <!-- Xposed module info -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="53" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- Settings screen (shown in the app drawer) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".SettingsProvider"
            android:authorities="kr.opencourse.godaijishou.provider"
            android:exported="true" />

        <!-- Second screen power menu, launched by the system_server hook (system uid may start it) -->
        <activity
            android:name=".PowerMenuActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity="kr.opencourse.godaijishou.powermenu"
            android:theme="@style/App.Theme.Godaijishou.PowerMenu" />


    </application>
</manifest>
