<?xml version="1.0" encoding="utf-8"?>
<!-- freetv settings style: title bar + group titles + rounded card rows -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ft_ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <!-- Title bar: name over live status, version pill (turns into the update button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Logo: Baloo 2 ExtraBold typeface + yellow trailing dot, both set in code -->
                <TextView
                    android:id="@+id/tv_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingTop="3dp"
                    android:text="@string/app_title"
                    android:textColor="@color/ft_ink"
                    android:textSize="25sp" />

                <!-- Live module status (dot + text), set in code -->
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/status_active"
                    android:textColor="@color/ft_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_ft_pill"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_ft_github"
                android:drawableTint="@color/ft_secondary"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ft_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reboot notice (shown only when needed) -->
        <LinearLayout
            android:id="@+id/notice_reboot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_ft_notice"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notice_reboot_title"
                android:textColor="@color/ft_butter"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:id="@+id/notice_reboot_text"
                android:text="@string/notice_reboot_desc"
                android:textColor="@color/ft_ink"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_notice_lsposed"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/row_lsposed_title"
                    android:textColor="@color/ft_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/ft_surface"
                    android:letterSpacing="0"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_notice_reboot"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/row_reboot_title"
                    android:textColor="@color/ft_on_butter"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/ft_butter"
                    android:letterSpacing="0"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode tabs: the tab picked is the mode (segments built in MainActivity) -->
        <LinearLayout
            android:id="@+id/mode_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <!-- Mode picked but not applied yet: its options are shown, applying is one tap -->
        <LinearLayout
            android:id="@+id/mode_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ft_notice"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mode_apply_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/ft_ink"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_apply"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/mode_apply"
                android:textAllCaps="false"
                android:textColor="@color/ft_on_butter"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ft_butter"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Original mode: what it does (shown on its tab) -->
        <LinearLayout
            android:id="@+id/card_original"
            style="@style/Ft.Row"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_display" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/mode_original_title" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/mode_original_desc" />
            </LinearLayout>
        </LinearLayout>

        <!-- Launcher -->
        <TextView
            android:id="@+id/group_launcher"
            style="@style/Ft.Group"
            android:drawableStart="@drawable/ic_ft_apps"
            android:text="@string/row_launcher_title" />

        <!-- Launcher rows are added by MainActivity -->
        <LinearLayout
            android:id="@+id/launcher_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Screen -->
        <TextView
            android:id="@+id/group_screen"
            style="@style/Ft.Group"
            android:drawableStart="@drawable/ic_ft_display"
            android:text="@string/group_screen" />


        <LinearLayout
            android:id="@+id/row_top_blackout"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_moon" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_top_blackout_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_top_blackout_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_top_blackout"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_volume_overlay"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_volume" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_volume_overlay_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_volume_overlay_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_volume_overlay"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <!-- Battery bar: one card. Header toggles it; under it the look, the position and
             the fullscreen rule (segments built in MainActivity). -->
        <LinearLayout
            android:id="@+id/card_battery_strip"
            style="@style/Ft.Row"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_battery_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Ft.RowIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ft_battery" />

                <LinearLayout style="@style/Ft.RowText">

                    <TextView
                        style="@style/Ft.RowTitle"
                        android:text="@string/main_battery_strip_switch" />

                    <TextView
                        style="@style/Ft.RowDesc"
                        android:text="@string/main_battery_strip_desc" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_battery_strip"
                    style="@style/Ft.Switch" />
            </LinearLayout>

            <!-- Body: a table of settings, one per line, hairlines between -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ft_table"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_strip_style"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_strip_style_title"
                        android:textColor="@color/ft_ink"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/strip_style_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ft_line" />

                <LinearLayout
                    android:id="@+id/row_strip_pos"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_strip_pos_title"
                        android:textColor="@color/ft_ink"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/strip_pos_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ft_line" />

                <LinearLayout
                    android:id="@+id/row_label_hide_fullscreen"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_label_hide_fullscreen_switch"
                        android:textColor="@color/ft_ink"
                        android:textSize="15sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_label_hide_fullscreen"
                        style="@style/Ft.Switch" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_hide_swivel_warnings"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_camera" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_hide_swivel_warnings_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_hide_swivel_warnings_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_hide_swivel_warnings"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_power_menu"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_power" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_power_menu_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_power_menu_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_power_menu"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <!-- Both modes -->
        <TextView
            android:id="@+id/group_common"
            style="@style/Ft.Group"
            android:drawableStart="@drawable/ic_ft_settings"
            android:text="@string/group_common" />

        <!-- Performance profile: title row, then eco / normal / turbo segments across the card -->
        <LinearLayout
            android:id="@+id/row_perf_profile"
            style="@style/Ft.Row"
            android:clickable="false"
            android:focusable="false"
            android:gravity="start"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Ft.RowIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ft_cpu" />

                <LinearLayout style="@style/Ft.RowText">

                    <TextView
                        style="@style/Ft.RowTitle"
                        android:text="@string/main_perf_profile" />

                    <TextView
                        style="@style/Ft.RowDesc"
                        android:text="@string/main_perf_profile_desc" />
                </LinearLayout>
            </LinearLayout>

            <!-- Built in MainActivity -->
            <LinearLayout
                android:id="@+id/perf_profile_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_slim_nav_pill"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_gesture_bar" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_slim_nav_pill_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_slim_nav_pill_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_slim_nav_pill"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_hide_ime_nav_strip"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_keyboard" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_hide_ime_nav_strip_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_hide_ime_nav_strip_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_hide_ime_nav_strip"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_fingerprint_off"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_fingerprint" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_fingerprint_off_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_fingerprint_off_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_fingerprint_off"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_force_rotation"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_rotate" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/main_force_rotation_switch" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/main_force_rotation_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_force_rotation"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <!-- Module -->
        <TextView
            style="@style/Ft.Group"
            android:drawableStart="@drawable/ic_ft_tune"
            android:text="@string/group_module" />

        <LinearLayout
            android:id="@+id/row_lsposed"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_puzzle" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/row_lsposed_title" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/row_lsposed_desc" />
            </LinearLayout>

            <ImageView
                style="@style/Ft.Chevron"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- USB mode: one row, title and the file transfer / charging only segments -->
        <LinearLayout
            android:id="@+id/row_usb_mode"
            style="@style/Ft.Row"
            android:clickable="false"
            android:focusable="false">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_usb" />

            <TextView
                style="@style/Ft.RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/row_usb_mode_title" />

            <!-- Built in MainActivity -->
            <LinearLayout
                android:id="@+id/usb_mode_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_debug_log"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_log" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/row_debug_log_title" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/row_debug_log_desc" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_debug_log"
                style="@style/Ft.Switch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_reboot"
            style="@style/Ft.Row">

            <ImageView
                style="@style/Ft.RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_restart" />

            <LinearLayout style="@style/Ft.RowText">

                <TextView
                    style="@style/Ft.RowTitle"
                    android:text="@string/row_reboot_title" />

                <TextView
                    style="@style/Ft.RowDesc"
                    android:text="@string/row_reboot_desc" />
            </LinearLayout>

            <ImageView
                style="@style/Ft.Chevron"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
