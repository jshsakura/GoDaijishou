<?xml version="1.0" encoding="utf-8"?>
<!-- Second screen power menu: one glass row of round actions over a blurred backdrop -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/power_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/power_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_ft_glass"
        android:clickable="true"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/btn_power_off"
            style="@style/Ft.GlassItem">

            <ImageView
                style="@style/Ft.GlassIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_power" />

            <TextView
                style="@style/Ft.GlassLabel"
                android:text="@string/power_off" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_restart"
            style="@style/Ft.GlassItem">

            <ImageView
                style="@style/Ft.GlassIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_restart" />

            <TextView
                style="@style/Ft.GlassLabel"
                android:text="@string/power_restart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_screenshot"
            style="@style/Ft.GlassItem">

            <ImageView
                style="@style/Ft.GlassIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_camera" />

            <TextView
                style="@style/Ft.GlassLabel"
                android:text="@string/power_screenshot" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/btn_recovery"
            style="@style/Ft.GlassItem">

            <ImageView
                style="@style/Ft.GlassIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ft_wrench" />

            <TextView
                style="@style/Ft.GlassLabel"
                android:text="@string/power_recovery" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
