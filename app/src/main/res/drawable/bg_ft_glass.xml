<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: translucent fill with a faint butter-to-white tint and a hairline edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="315"
                android:endColor="#14FFFFFF"
                android:startColor="#38FFC23D"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#40121216" />
        </shape>
    </item>
</layer-list>
