<?xml version="1.0" encoding="utf-8"?>
<!-- Glass tile for the power menu: brighter when pressed, yellow outline when focused -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFC23D">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#2EFFFFFF" />
                    <stroke android:width="1dp" android:color="#66FFC23D" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#24FFFFFF" />
                    <stroke android:width="2dp" android:color="@color/ft_butter" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#14FFFFFF" />
                    <stroke android:width="1dp" android:color="#24FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
